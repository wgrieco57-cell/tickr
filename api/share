// api/share.js - HTML redirect with OG tags for reliable social previews
export default async function handler(req, res) {
  res.setHeader('Content-Type', 'text/html');
  res.setHeader('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

  try {
    const url = new URL(req.url, `http://${req.headers.host}`);
    const host = req.headers.host;
    const protocol = host.includes('localhost') ? 'http' : 'https';
    const baseUrl = `${protocol}://${host}`;

    // Extract query params for OG image
    const date = url.searchParams.get('date') || '';
    const clues = url.searchParams.get('clues') || '';
    const time = url.searchParams.get('time') || '';
    const streak = url.searchParams.get('streak') || '';
    const grid = url.searchParams.get('grid') || '';
    const mode = url.searchParams.get('mode') || 'daily';
    const pct = url.searchParams.get('pct') || '';

    // Build OG image URL with params
    const ogImageParams = new URLSearchParams();
    if (date) ogImageParams.set('date', date);
    if (clues) ogImageParams.set('clues', clues);
    if (time) ogImageParams.set('time', time);
    if (streak) ogImageParams.set('streak', streak);
    if (grid) ogImageParams.set('grid', grid);
    if (mode) ogImageParams.set('mode', mode);
    if (pct) ogImageParams.set('pct', pct);

    const ogImageUrl = `${baseUrl}/api/og?${ogImageParams.toString()}`;

    const title = clues && time 
      ? `I solved TickrDaily in ${clues}/5 clues (${time}s)!`
      : 'TickrDaily - Guess the stock ticker';

    const description = grid
      ? `My result: ${grid}`
      : 'Guess the stock ticker in 5 clues. New puzzle daily.';

    const html = `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${title}</title>
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="${baseUrl}">
  <meta property="og:title" content="${title}">
  <meta property="og:description" content="${description}">
  <meta property="og:image" content="${ogImageUrl}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="${baseUrl}">
  <meta name="twitter:title" content="${title}">
  <meta name="twitter:description" content="${description}">
  <meta name="twitter:image" content="${ogImageUrl}">
  
  <!-- Redirect to main app -->
  <meta http-equiv="refresh" content="0;url=/">
  <script>
    // Fallback redirect
    window.location.href = '/';
  </script>
</head>
<body>
  <p>Redirecting to TickrDaily...</p>
  <p>If you are not redirected automatically, <a href="/">click here</a>.</p>
</body>
</html>`;

    res.status(200).send(html);

  } catch (error) {
    console.error('Share endpoint error:', error);
    res.status(500).send('<!DOCTYPE html><html><body>Error generating share link</body></html>');
  }
}
